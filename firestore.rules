rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user's board lives at boards/{their uid}/cards/{cardId} — only
    // that signed-in user (including anonymous/guest sessions) can read or
    // write their own board.
    match /boards/{uid}/cards/{cardId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
