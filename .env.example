# Copy this file to .env and fill in the values from your Firebase project's
# web app config (Firebase console → Project settings → Your apps → Web app).
# These are NOT secret keys — Firebase's client config is meant to be public;
# access control is enforced by Firestore security rules, not by hiding this.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
